{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings window: event listening and every app command.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:event:default",
    "core:app:default",
    "allow-get-prefs",
    "allow-set-prefs",
    "allow-list-microphones",
    "allow-get-model-status",
    "allow-history-list",
    "allow-history-delete",
    "allow-history-clear",
    "allow-history-copy",
    "allow-history-repaste",
    "allow-insights-get",
    "allow-insights-reset",
    "allow-clipboard-copy",
    "allow-suggestions-list",
    "allow-suggestion-accept",
    "allow-suggestion-dismiss",
    "allow-app-style-choices",
    "allow-recent-apps-clear",
    "allow-dictionary-import",
    "allow-dictionary-export",
    "allow-dictionary-export-text",
    "allow-pick-path",
    "allow-open-external",
    "allow-dev-get",
    "allow-dev-validate",
    "allow-dev-set",
    "allow-dev-test-connection",
    "allow-dev-test-session",
    "allow-dev-route-status",
    "allow-dev-reset-circuit",
    "allow-dev-reset-defaults",
    "allow-dev-unlock",
    "allow-dev-cloud-set-key",
    "allow-dev-cloud-clear-key",
    "allow-dev-cloud-usage",
    "allow-dev-cloud-reset-usage",
    "allow-dev-or-get",
    "allow-dev-or-catalog",
    "allow-dev-or-catalog-status",
    "allow-dev-or-refresh-catalog",
    "allow-dev-or-key-info",
    "allow-dev-or-set-model",
    "allow-dev-or-set-stt",
    "allow-dev-or-set-cleanup",
    "allow-dev-or-set-privacy",
    "allow-dev-or-set-budget",
    "allow-dev-or-ack-notice",
    "allow-dev-or-test-stt",
    "allow-dev-or-test-cleanup",
    "allow-dev-or-cleanup-status",
    "allow-debug-log-status",
    "allow-debug-log-set",
    "allow-debug-log-clear",
    "allow-debug-log-open-folder"
  ]
}
