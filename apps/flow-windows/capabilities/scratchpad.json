{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "scratchpad",
  "description": "Scratchpad window: load, edit and flush its note and copy its text (nothing else).",
  "windows": [
    "scratchpad"
  ],
  "permissions": [
    "allow-note-load",
    "allow-note-edit",
    "allow-note-flush",
    "allow-clipboard-copy"
  ]
}
