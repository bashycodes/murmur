<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Flow" parent="@android:style/Theme.DeviceDefault.DayNight">
        <!-- Light: the design is monochrome, so the accent (dialog buttons, cursor, selection) is the ink (ui/Tokens.kt). -->
        <item name="android:colorAccent">#FF1A1A1A</item>
    </style>

    <!-- App shell (own top bar, bottom nav and drawer from ui/DevUi.kt): no action bar.
         Not used by any activity yet; the shell chunk switches activities to it. -->
    <style name="Theme.Flow.Shell">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
