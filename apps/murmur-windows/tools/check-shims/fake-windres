#!/bin/sh
# CHECK-ONLY stand-in for a Windows resource compiler, so that
#   RC=$PWD/tools/check-shims/fake-windres \
#     cargo check --target x86_64-pc-windows-msvc --features app
# works on a Linux host without llvm-rc / rc.exe. tauri-build always runs
# embed-resource; `cargo check` never links, so an empty .res is fine.
# NEVER use this for a real build: the exe would lack its icon/manifest.
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -V) echo "GNU windres (flow-windows check-only shim)"; exit 0 ;;
    --output) out="$2"; shift ;;
  esac
  shift
done
[ -n "$out" ] && : > "$out"
exit 0
