{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "scratchpad",
  "description": "Scratchpad / Notes window: list, create, edit, pin, delete and export notes and copy their text (nothing else).",
  "windows": [
    "scratchpad"
  ],
  "permissions": [
    "allow-note-load",
    "allow-note-edit",
    "allow-note-flush",
    "allow-note-list",
    "allow-note-create",
    "allow-note-delete",
    "allow-note-set-pinned",
    "allow-note-export",
    "allow-clipboard-copy"
  ]
}
