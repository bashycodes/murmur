<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts (long-press the Murmur icon). The Quick note keeps the
     "scratchpad" id so a shortcut pinned before Notes still works. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_note"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_new_note_short"
        android:shortcutLongLabel="@string/shortcut_new_note_long">
        <!-- NoteEditorActivity.ACTION_NEW_NOTE: a fresh note, field focused, keyboard up. -->
        <intent
            android:action="dev.murmur.action.NEW_NOTE"
            android:targetPackage="dev.murmur"
            android:targetClass="dev.murmur.ui.NoteEditorActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="scratchpad"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_scratchpad_short"
        android:shortcutLongLabel="@string/shortcut_scratchpad_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="dev.murmur"
            android:targetClass="dev.murmur.ui.NoteEditorActivity" />
    </shortcut>
</shortcuts>
