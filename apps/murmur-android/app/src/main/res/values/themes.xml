<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Murmur" parent="@android:style/Theme.DeviceDefault.DayNight">
        <!-- Light: the design is monochrome, so the accent (dialog buttons, cursor, selection) is the ink (ui/Tokens.kt). -->
        <item name="android:colorAccent">#FF1A1A1A</item>
    </style>

    <!-- App shell (own top bar, bottom nav and drawer from ui/DevUi.kt, ui/Shell.kt): no action bar.
         MainActivity and PermissionsActivity; restyled screens switch to it as they get their own top bar. -->
    <style name="Theme.Murmur.Shell">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
